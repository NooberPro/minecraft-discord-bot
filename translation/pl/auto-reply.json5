// GitHub: https://github.com/NooberPro/minecraft-discord-bot
// Crowdin: https://crowdin.com/project/minecraft-discord-bot
// Polish Translation (pl) by MizPablito

{
  // Translation for the auto-reply function.
  version: {
    // Use {version} to retrieve the version from the config.
    replyText: "Wersja serwera: **`{version}`**.",
  },
  ip: {
    // Use {ip} for the IP and {port} for the port.
    replyText: '**IP: `{ip}`\nPort: `{port}`**',
  },
  site: {
    // Use {site} for website link from the config.
    replyText: "Strona serwera: **<{site}>**.",
  },
  status: {
    // Use {playerOnline} for the number of online players and {playerMax} for the maximum number of players. This only works in onlineReply.
    onlineReply: 'Serwer jest aktualnie **`🟢ONLINE`** i gra na nim **`{playerOnline}/{playerMax}`** graczy.',
    offlineReply: 'Serwer jest aktualnie **`🔴OFFLINE`**.',
  },
}
