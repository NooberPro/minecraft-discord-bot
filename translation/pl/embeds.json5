// GitHub: https://github.com/NooberPro/minecraft-discord-bot
// Crowdin: https://crowdin.com/project/minecraft-discord-bot
// Polish Translation (pl) by MizPablito

{
  // Translation for command embeds message.
  ip: {
    // Variables: {ip}
    title: '__**ADRES SERWERA**__',
    description: '**{ip}**',
  },
  site: {
    // Variables: {site}
    title: '__**STRONA WWW**__',
    description: '**Link: {site}**',
  },
  version: {
    // Variables: {version}
    title: '__**WERSJA**__',
    description: '**{version}**',
  },
  offlineEmbed: {
    // Variables: {ip},{version}, {site}
    title: ':red_circle: OFFLINE',
    description: '', // To disable this, leave the description blank.
    footer: 'Sprawdzono o',
  },
  players: {
    // Variables: {playeronline}, {playermax}
    title: '__**PLAYERS**__',
    description: '**{playeronline}/{playermax}**',
    // The player name list will be displayed after the description.
    // Displays offline embeds when the Minecraft server is offline.
  },
  motd: {
    // Variables: {motd}
    title: '__**MOTD**__',
    description: '**{motd}**',
  },
  onlineEmbed: {
    // Variables: {ip}, {motd}, {version}, {site}
    title: ':green_circle: ONLINE',
    // Here, the player list embed title and description from above (line: 28).

    // The description is placed after the player list field.
    description_field_one: '__**MOTD**__\n**{motd}**\n\n__**ADRES SERWERA**__\n**{ip}**',
    description_field_two: '‎ \n__**WERSJA**__\n**{version}**{siteText}',
    siteText: '\n\n__**STRONA WWW**__\n**Link: {site}**',
    footer: 'Sprawdzono o',
  },
  help: {
    // Variables: {prefix}, {botName}
    title: '__**LISTA KOMEND**__',
    description: '**Prefiks: `{prefix}`**',
    // Only listFormat variables: {cmdDescription}, {cmdSlashMention}.
    listFormat: '{slashCmdMention} **`-` {cmdDescription}**',

    commandInfoFormat: {
      // Variables: {cmdName}
      title: '__**{cmdName} Command**__',
      // Variables: {cmdSlashMention}, {cmdDescription}, {prefixCmd}, {prefixCmdAlias}
      description: '**Komenda ukośnikowa: {cmdSlashMention}\nOpis: `{cmdDescription}`\nKomenda prefiksowa: `{prefixCmd}`\nAliasy komendy prefiksowej: {prefixCmdAlias}**',
    },
  },
  info: {
    title: '**Bot Info and Stats**',
    // Variables: {cpuUsage}, {memoryUsage}, {nodeVersion}, {uptimeDays}, {uptimeHours}, {uptimeMinutes}, {uptimeSeconds}, {ping}, {websocket}
    description: '**Użycie CPU: `{cpuUsage}%`\nUżycie RAM: `{memoryUsage}MB`\nWersja Node.js: `{nodeVersion}`\nUptime bota: `{uptimeDays}` dni, `{uptimeHours}` godz., `{uptimeMinutes}`, min., `{uptimeSeconds}` sek.\nPing: Client `{ping}ms` | Websocket: `{websocket}ms` **',
  },
}
