// Crowdin (Сайт для перевода): https://crowdin.com/project/minecraft-discord-bot
// Русский перевод (ru) от Zahar1loshara

{
  // Перевод для функции автоответа.
  version: {
    // Используйте {version} для получения версии из конфига.
    replyText: 'Версия сервера: **`{version}`**.',
  },
  ip: {
    // Используйте {ip} для IP и {port} для порта.
    replyText: '**IP: `{ip}`\nПорт: `{port}`**',
  },
  site: {
    // Используйте {site} для сайта с конфига.
    replyText: 'Сайт сервера: **<{site}>**.',
  },
  status: {
    // Изпользуйте {playerOnline} для числа онлайна и {playerMax} для максимума игроков. Это работает только в onlineReply.
    onlineReply: 'Сервер сейчас **`🟢ОНЛАЙН`** с **`{playerOnline}/{playerMax}`** активными игроками.',
    offlineReply: 'Сервер сейчас **`🔴ОФЛАЙН`**.',
  },
}
