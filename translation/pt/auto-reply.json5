// GitHub: https://github.com/NooberPro/minecraft-discord-bot
// Crowdin: https://crowdin.com/project/minecraft-discord-bot
// Tradução para o português (pt) pela IA

{
  // Tradução para a função de resposta automática.
  version: {
    // Use {version} para recuperar a versão.
    replyText: 'A versão do servidor: **`{version}`**.',
  },
  ip: {
    // Use {ip} para o IP e {port} para a porta.
    replyText: '**IP: `{ip}`\nPorta: `{port}`**',
  },
  site: {
    // Use {site} para o link do site a partir da configuração.
    replyText: 'O link do site do servidor: **<{site}>**.',
  },
  status: {
    // Use {playerOnline} para o número de jogadores online e {playerMax} para o número máximo de jogadores. Isso só funciona em onlineReply.
    onlineReply: 'O servidor está atualmente **`🟢ONLINE`** com **`{playerOnline}/{playerMax}`** jogadores ativos.',
    offlineReply: 'O servidor está atualmente **`🔴OFFLINE`**.',
  },
}
